# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and publishable key (Supabase's current client-safe key,
# replacing the legacy "anon" key) are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret/service-role key: SERVER-SIDE ONLY. Never import this in client
# components or expose it via a NEXT_PUBLIC_ variable. Used by API routes,
# cron jobs and background workers that need to bypass Row Level Security
# intentionally (e.g. the job-ingestion worker writing to the public jobs
# table). Supabase now calls this the "secret key" on newer projects — the
# legacy "service_role" key works the same way here.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────
# Used for CV parsing, AI job matching explanations, CV tailoring and cover
# letter generation. Without this key the app runs its CV parser and copy
# generators in a deterministic heuristic fallback mode instead of failing.
OPENAI_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────
# Used for authorised email-based job applications and transactional
# notifications. Without this key, email application submission is reported
# as NOT_CONFIGURED rather than silently pretending to send.
RESEND_API_KEY=

# ── Cron / background jobs ──────────────────────────────────────────────--
# Shared secret required in the `Authorization: Bearer <CRON_SECRET>` header
# for /api/cron/* routes, so job ingestion / expiry can't be triggered by
# anonymous requests.
CRON_SECRET=

# ── Optional: authorised job source credentials ─────────────────────────--
# Each is optional. Missing credentials/config mean that source's adapter
# reports status NOT_CONFIGURED and is skipped during ingestion instead of
# being faked. The ATS adapters (Greenhouse/Lever/Workable/SmartRecruiters/
# Ashby) read each vendor's *public* job-board API, so what they need isn't
# a secret API key but the list of employer board identifiers to poll —
# supplied as a comma-separated list once an employer partnership exists.
JOBSPLUS_API_KEY=
EURES_API_KEY=
# Example (verified Malta-relevant boards): GREENHOUSE_BOARD_TOKENS=betsson,eqvilentjobs
GREENHOUSE_BOARD_TOKENS=
LEVER_SITE_IDS=
WORKABLE_ACCOUNT_SUBDOMAINS=
SMARTRECRUITERS_COMPANY_IDS=
ASHBY_JOB_BOARD_NAMES=

# Permitted browser automation (spec §18) only ever runs against a job's
# real application_url for a domain listed here — comma-separated
# hostnames, e.g. "boards.greenhouse.io,jobs.lever.co". Add a domain only
# after manually verifying that employer's application flow works safely
# with the automation provider. Left empty, a job with no other configured
# submission channel safely resolves to manual_required with its real
# application link instead — never a browser launch attempt.
BROWSER_AUTOMATION_ALLOWED_DOMAINS=
